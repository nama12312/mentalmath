<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/round_over"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/finalScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="84sp" />

        <TextView
            android:id="@+id/newBest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="@string/new_best"
            android:textColor="@color/streak"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/levelChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_light"
            android:textSize="20sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/card_bg"
            android:columnCount="2"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView android:id="@+id/statCorrect" style="@style/StatValue" android:textColor="@color/correct" />
                <TextView style="@style/StatLabel" android:text="@string/correct" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView android:id="@+id/statAccuracy" style="@style/StatValue" />
                <TextView style="@style/StatLabel" android:text="@string/accuracy" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView android:id="@+id/statAvgTime" style="@style/StatValue" />
                <TextView style="@style/StatLabel" android:text="@string/avg_time" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView android:id="@+id/statStreak" style="@style/StatValue" android:textColor="@color/streak" />
                <TextView style="@style/StatLabel" android:text="@string/best_streak" />
            </LinearLayout>
        </GridLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/playAgainButton"
            style="@style/BigButton"
            android:layout_marginTop="24dp"
            android:text="@string/play_again" />

        <TextView
            android:id="@+id/homeButton"
            style="@style/BigButton"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_ghost"
            android:text="@string/home"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
